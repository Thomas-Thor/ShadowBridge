{
  "name": "shadowbridge-v2-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Local browser and accessibility checks for the isolated ShadowBridge V2 prototype.",
  "scripts": {
    "test": "playwright test --config tests/playwright.config.cjs",
    "test:list": "playwright test --config tests/playwright.config.cjs --list",
    "test:accessibility": "playwright test --config tests/playwright.config.cjs --grep accessibility"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1"
  }
}
