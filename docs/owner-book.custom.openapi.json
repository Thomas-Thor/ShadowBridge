                          "string",
                          "null"
                        ],
                        "format": "date-time"
                      },
                      "starts_at": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "format": "date-time"
                      },
                      "ends_at": {
                        "type": [
                          "string",
