# Documentation only. For local development run node scripts/dev-up.mjs.
# That command creates random secrets in .local/development.env (never commit it).
APP_ENV=local
APP_URL=http://127.0.0.1:8088
HOST=127.0.0.1
PORT=8088
SUPABASE_URL=http://127.0.0.1:9999
SUPABASE_ANON_KEY=
DATABASE_URL=
SESSION_DATABASE_URL=
DATABASE_ADMIN_URL=
# Base64-encoded 32 random bytes; not a password or provider JWT signing secret.
SESSION_ENCRYPTION_KEY=

# Production additionally requires an HTTPS APP_URL/SUPABASE_URL, explicit HOST,
# strong server secrets, and approved managed services. Never publish this file.
